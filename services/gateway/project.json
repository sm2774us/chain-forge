{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "lang:go"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/go"
      ],
      "options": {
        "commands": [
          "CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o ../../dist/go/gateway ./cmd/gateway",
          "CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o ../../dist/go/chainsim ./cmd/chainsim"
        ],
        "parallel": false,
        "cwd": "services/gateway"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -race ./...",
        "cwd": "services/gateway"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/go-coverage.sh"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "test -z \"$(gofmt -l .)\"",
          "go vet ./..."
        ],
        "parallel": false,
        "cwd": "services/gateway"
      }
    }
  },
  "implicitDependencies": [
    "engine",
    "signer"
  ]
}
